{
  "name": "@abyssalfragments/linter-config",
  "version": "1.5.1",
  "description": "Abyssal Fragments shared linter config (eslint, prettier, etc)",
  "bugs": {
    "url": "https://git.abyssalfragments.org/packages/linter-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lillith Rose",
    "email": "lillithrose@abyssalfragments.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbyssalFragments/linter-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./plugins/header": "./dist/plugins/header.mjs",
    "./plugins/lillith": "./dist/plugins/lillith.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "oxlint . && oxfmt --check",
    "fix": "eslint . --fix",
    "format": "oxfmt",
    "lint:dev": "npm run build && npm run lint"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@oxlint/plugins": "^1.94.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "oxlint-plugin-eslint": "^1.94.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@astrojs/compiler-rs": "^0.5.0",
    "eslint": "^10.0.0",
    "oxfmt": ">=0.78.0 <1.0.0",
    "oxlint": ">=1.93.0 <2.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler-rs": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
